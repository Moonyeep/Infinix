# Ativa o núcleo do agente local
ZS_AGENT_ENABLED=1
# O modo geral não inicializa Roblox. Use 1 apenas no launcher Roblox.
ZS_ROBLOX_ENABLED=0
# Workspace que pode ser lido/editado pelo agente
ZS_AGENT_WORKSPACE=.
# Raízes adicionais separadas por ; no Windows ou : no macOS/Linux
ZS_AGENT_WORKSPACE_ROOTS=./;~/Downloads;~/Desktop;~/Documents
# Porta local do bridge
ZS_BRIDGE_PORT=17613
# Browser Playwright isolado opcional; deixe desligado no primeiro uso
ZS_BROWSER_ENABLED=0
ZS_BROWSER_HOSTS=example.com,docs.python.org
# Clique e preenchimento de formulários são efeitos externos: mantenha desligados
# até compreender e aprovar o risco. As ferramentas ainda passam pela política.
ZS_BROWSER_ALLOW_EXTERNAL_EFFECTS=0
# Destinos localhost/IP privados são negados por padrão; habilite só para testes locais controlados.
ZS_BROWSER_ALLOW_PRIVATE_HOSTS=0
# Timeout do ciclo semanal de melhoria, em segundos
ZS_IMPROVE_TIMEOUT=14400
# Endpoint OpenAI-compatible para propostas semanais; HTTP só é aceito em localhost
# ZS_IMPROVE_API_BASE=https://seu-provedor-confiavel/v1
# ZS_IMPROVE_MODEL=nome-do-modelo
# Defina ZS_IMPROVE_API_KEY no gerenciador de ambiente/segredos do sistema, não neste arquivo.
# Ative apenas se autorizar propostas remotas sem confirmação por execução.
# ZS_IMPROVE_ALLOW_SOURCE_UPLOAD=1

# Diagnóstico local: consultas são read-only e limitadas; scans/reparos seguem o perfil da sessão.
# Amplo (duas confirmações no início) não pede aprovação por chamada; Básico/Desenvolvimento podem pedir.
# Shell executa como o usuário da bridge; não eleva UAC/sudo automaticamente.
